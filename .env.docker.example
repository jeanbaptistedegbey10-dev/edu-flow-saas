# =============================================================================
# EduFlow — Variables d'environnement de la pile Docker (On-Premise)
# =============================================================================
# 1. Copiez ce fichier :   cp .env.docker.example .env.docker
# 2. Renseignez les secrets ci-dessous (mot de passe PostgreSQL, AUTH_SECRET,
#    clé publique de licence…)
# 3. Démarrez :            docker compose --env-file .env.docker up -d --build
#
# Documentation complète : docs/SELF_HOSTED.md
# =============================================================================

# --- PostgreSQL interne au serveur -------------------------------------------
# Ces valeurs construisent les DATABASE_URL / DIRECT_URL pointant vers le
# service `db` de la stack. Pour utiliser une base EXTERNE, décommentez et
# renseignez DATABASE_URL / DIRECT_URL plus bas (elles prennent alors le dessus).
POSTGRES_USER=eduflow
# Générez un mot de passe fort :  openssl rand -base64 18
POSTGRES_PASSWORD=CHANGEZ_MOI_MOT_DE_PASSE_FORT
POSTGRES_DB=eduflow
# DATABASE_URL=postgresql://user:pass@hote:5432/eduflow?schema=public
# DIRECT_URL=postgresql://user:pass@hote:5432/eduflow

# --- Application --------------------------------------------------------------
# Port public de l'application (http://<ip-du-serveur>:<APP_PORT>).
APP_PORT=3000
# Secret de signature des sessions Auth.js.
# Génération :  openssl rand -hex 32
#          ou :  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=CHANGEZ_MOI_AUTH_SECRET_64_HEX
# URL publique (affichée dans les e-mails, callbacks…).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Clés de licence Ed25519 (Phase 2 / Phase 4) -------------------------------
# La clé PUBLIQUE de votre plateforme EduFlow : les clés de licence
# « EDU-XXXX-… » générées depuis le back-office Super-Admin (avec la clé
# PRIVÉE) sont vérifiées HORS-LIGNE avec cette clé publique sur n'importe
# quelle instance cliente (self-hosted / desktop).
#
# ▶ Où la trouver ? Elle est contenue dans LICENSES_PUBLIC_KEY du serveur
#   d'administration. Génération d'un nouveau couple de clés :
#     npm run license:keygen -- --keygen
#
# ⛔ NE JAMAIS déployer LICENSE_PRIVATE_KEY sur une instance cliente.
LICENSE_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----
REMPLACEZ_PAR_VOTRE_CLE_PUBLIQUE_SPKI
-----END PUBLIC KEY-----"

# --- Passerelle de paiement (optionnelle) --------------------------------------
# Laisser VIDE pour désactiver les paiements en ligne sur cette instance.
# Agrégateur : FedaPay (https://cdn.fedapay.com/fedapay.js).
PAYMENT_PROVIDER=fedapay
# Clé PUBLIQUE FedaPay (widget côté client) — pk_live_… en production.
NEXT_PUBLIC_FEDAPAY_PUBLIC_KEY=
# Clé SECRÈTE FedaPay (serveur) — sk_live_… en production.
FEDAPAY_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=
# Mettre « false » et renseigner les clés réelles pour un déploiement en prod.
PAYMENT_SANDBOX=true

# --- E-mails transactionnels (optionnel) ---------------------------------------
# Laisser RESEND_API_KEY vide pour désactiver l'envoi d'e-mails.
RESEND_API_KEY=
EMAIL_FROM=EduFlow <onboarding@resend.dev>