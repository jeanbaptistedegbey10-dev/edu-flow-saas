generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// --------------------------------------
// Enums
// --------------------------------------

enum Role {
  SUPER_ADMIN
  ADMIN
  STAFF
  TEACHER
  STUDENT
}

enum StudentStatus {
  PROSPECT
  ENROLLED
  IN_PROGRESS
  COMPLETED
  SUSPENDED
  DROPPED_OUT
}

enum ClientType {
  LANGUAGE_ONLY
  LANGUAGE_AND_TRAVEL
  TRAVEL_ONLY
}

enum PaymentStatus {
  PENDING
  PARTIAL
  COMPLETED
  FAILED
  REFUNDED
}

/// Type de réduction accordée sur les frais de scolarité d'un étudiant :
/// un pourcentage du coût total ou un montant fixe en FCFA.
enum DiscountType {
  PERCENTAGE
  FIXED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  MOBILE_MONEY
  CREDIT_CARD
  CHECK
}

enum TravelStatus {
  DOSSIER_PREPARATION
  LANGUAGE_TEST
  ADMISSION_APPLIED
  ADMISSION_OBTAINED
  VISA_APPLIED
  VISA_APPROVED
  VISA_REJECTED
  DEPARTURE_READY
  COMPLETED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum SaleStatus {
  COMPLETED
  PENDING
  REFUNDED
}

enum DocumentType {
  PASSPORT
  IDENTITY
  DIPLOMA
  OTHER
}

enum ReferralStatus {
  PENDING
  CONVERTED
}

enum RegistrationFeePolicy {
  ONCE_PER_STUDENT
  EVERY_NEW_ENROLLMENT
}

// --------------------------------------
// Documents & Pièces jointes
// --------------------------------------

/// Pièce jointe rattachée à un étudiant ou à un dossier de voyage.
/// Le fichier lui-même est conservé sur un stockage externe (Drive, storage) ;
/// seul le lien distant (`fileUrl`) est enregistré en base.
model Document {
  id                String       @id @default(cuid())
  organizationId    String
  title             String
  type              DocumentType @default(OTHER)
  fileUrl           String
  fileSize          Int?
  studentId         String?
  travelProcedureId String?
  createdAt         DateTime     @default(now())

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  student         Student?         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  travelProcedure TravelProcedure? @relation(fields: [travelProcedureId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([studentId])
  @@index([travelProcedureId])
}

// --------------------------------------
// Configuration globale (clé/valeur) — Paramètres système SaaS
// --------------------------------------

/// Stockage clé/valeur des paramètres globaux de la plateforme
/// (clés API de paiement, configuration licence, préférences email…).
///
/// Réservé au Super-Admin : chaque paramètre est identifié par une `key`
/// unique (ex : « kkiapay.publicKey ») et persiste sa valeur en `value`.
/// La lecture côté logique métier applique un fallback sur les variables
/// d'environnement si la clé n'est pas renseignée en base.
model SystemSettings {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @default("")
  /// Description lisible affichée dans l'UI (documentation pour le Super-Admin).
  label     String?
  /// Indique si la valeur est sensible (clé secrète) → masquée par défaut dans l'UI.
  isSecret  Boolean  @default(false)
  /// Catégorie de regroupement (« payment », « license », « email »…).
  category  String   @default("general")
  updatedAt DateTime @updatedAt
  updatedBy String?

  @@index([category])
  @@map("system_settings")
}

// --------------------------------------
// Core / Multi-Tenant Models
// --------------------------------------

model Organization {
  id                     String   @id @default(cuid())
  name                   String
  slug                   String   @unique
  email                  String?
  phone                  String?
  address                String?
  city                   String?
  website                String?
  logoUrl                String?
  rccm                   String?
  ifu                    String?
  /// Frais d'inscription uniques facturés une seule fois par étudiant (FCFA).
  defaultRegistrationFee Float    @default(15000)
  /// Politique de frais d'inscription : une seule fois par étudiant ou à chaque nouvelle inscription.
  registrationFeePolicy RegistrationFeePolicy @default(ONCE_PER_STUDENT)
  /// Solde initial / solde de départ de la caisse (FCFA) : montant d'ouverture
  /// saisi lors de l'adoption du logiciel, intégré au calcul de trésorerie
  /// (Solde total = Solde initial + Encaissements − Dépenses).
  initialCashBalance     Float    @default(0)

  // --------------------------------------
  // Abonnement / Licence (commercialisation multi-versions : SaaS + Licences)
  // --------------------------------------
  /// Type de plan commercial :
  /// - TRIAL         : période d'essai gratuit (30 jours à l'onboarding) ;
  /// - SAAS_MONTHLY  : abonnement SaaS mensuel (cloud) ;
  /// - SAAS_YEARLY   : abonnement SaaS annuel (cloud) ;
  /// - SELF_HOSTED   : licence installée chez le client ;
  /// - OFFLINE       : licence hors-ligne.
  planType String @default("TRIAL")
  /// Statut du plan : ACTIVE, EXPIRED ou CANCELLED.
  planStatus String @default("ACTIVE")
  /// Fin de la période d'essai gratuit (fixée à J+30 à la création de
  /// l'organisation). Au-delà, les écritures sont bloquées (voir
  /// src/lib/license-check.ts).
  trialEndsAt DateTime?
  /// Clé de licence (éditions SELF_HOSTED / OFFLINE), unique globalement.
  licenseKey String? @unique
  /// Fin de validité de la licence (null = licence perpétuelle).
  licenseEndsAt DateTime?

  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  users            User[]
  students         Student[]
  courses          Course[]
  classes          Class[]
  classEnrollments ClassEnrollment[]
  payments         Payment[]
  travelProcedures TravelProcedure[]
  expenses         Expense[]
  payrolls         Payroll[]
  tasks            Task[]
  workflows        Workflow[]
  workflowStages   WorkflowStage[]
  productServices  ProductService[]
  productCategories ProductCategory[]
  sales            Sale[]
  attendances      Attendance[]
  classSessions    ClassSession[]
  courseLogs       CourseLog[]
  evaluations      Evaluation[]
  documents        Document[]
  customRoles      CustomRole[]
  housings         Housing[]
  invoices         Invoice[]
}

model User {
  id             String   @id @default(cuid())
  organizationId String
  email          String   @unique
  passwordHash   String
  firstName      String
  lastName       String
  role           Role     @default(STAFF)
  avatarUrl      String?
  isActive       Boolean  @default(true)
  /// Rôle personnalisé (matrice de permissions) assigné à l'utilisateur.
  customRoleId   String?
  /// Code de parrainage unique (hash court) — généré automatiquement à la création.
  referralCode   String?  @unique
  /// Utilisateur qui a parrainé ce compte (via un lien ?ref=CODE).
  referredById   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customRole      CustomRole?       @relation(fields: [customRoleId], references: [id], onDelete: SetNull)
  referredBy      User?             @relation("UserReferrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals       User[]            @relation("UserReferrals")
  taughtCourses   Course[]          @relation("TeacherCourses")
  taughtClasses   Class[]           @relation("TeacherClasses")
  createdExpenses Expense[]         @relation("ExpenseCreator")
  /// Versements reçus (dépenses de salaire dont ce membre est bénéficiaire).
  receivedExpenses Expense[]        @relation("ExpenseRecipient")
  payrolls        Payroll[]
  assignedTasks   Task[]            @relation("TaskAssignee")
  createdTasks    Task[]            @relation("TaskCreator")
  managedTravels  TravelProcedure[] @relation("TravelAdvisor")
  createdSales    Sale[]            @relation("SaleCreator")
  courseLogs      CourseLog[]       @relation("TeacherCourseLogs")
  sentReferrals   Referral[]        @relation("ReferrerUser")
  receivedReferrals Referral[]      @relation("ReferredUser")
}

// --------------------------------------
// Student & Academic Models
// --------------------------------------

model Student {
  id                     String        @id @default(cuid())
  organizationId         String
  studentCode            String        @unique
  firstName              String
  lastName               String
  email                  String?
  phone                  String
  clientType             ClientType    @default(LANGUAGE_AND_TRAVEL)
  totalCost              Float?
  discount               Float?
  /// Type de réduction : pourcentage du coût total ou montant fixe en FCFA.
  discountType           DiscountType  @default(FIXED)
  netAmount              Float?
  /// Paiements antérieurs hors système (FCFA) : montant déjà réglé par
  /// l'étudiant AVANT l'adoption du logiciel. Déduit du reste à payer mais
  /// jamais comptabilisé dans le journal de caisse courant tant que
  /// `legacyAmountInCashJournal` est faux.
  legacyPaidAmount       Float         @default(0)
  /// Indique si le montant hérité a été injecté dans le journal de caisse
  /// courant (paiement « LEGACY-* » créé). Défaut : false — cohérent avec la
  /// case « Ne pas inclure dans le journal de caisse actuel » cochée.
  legacyAmountInCashJournal Boolean    @default(false)
  dateOfBirth            DateTime?
  address                String?
  status                 StudentStatus @default(PROSPECT)
  /// Frais d'inscription déjà réglés au moins une fois (uniques à vie).
  hasPaidRegistrationFee Boolean       @default(false)
  /// Classe / cohorte active de l'étudiant (dernière affectation).
  currentClassId         String?
  /// Indique si l'étudiant est autonome (s'assume lui-même financièrement).
  isSelfFinanced         Boolean       @default(false)
  /// Nom du parent / tuteur (requis si non autonome).
  parentName             String?
  /// Lien avec l'étudiant (Père, Mère, Tuteur, etc.).
  parentRelation         String?
  /// Numéro de téléphone principal du parent / tuteur.
  parentPhone1           String?
  /// Numéro de téléphone secondaire du parent / tuteur (optionnel).
  parentPhone2           String?
  /// Token d'accès public non modifiable pour le rapport parent.
  publicReportToken      String?       @unique
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  enrollments      Enrollment[]
  classEnrollments ClassEnrollment[]
  currentClass     Class?            @relation("StudentCurrentClass", fields: [currentClassId], references: [id], onDelete: SetNull)
  payments         Payment[]
  travelProcedures TravelProcedure[]
  tasks            Task[]
  attendances      Attendance[]
  sales            Sale[]
  grades           Grade[]
  documents        Document[]
  housings         Housing[]
}

model Course {
  id             String   @id @default(cuid())
  organizationId String
  teacherId      String?
  title          String
  code           String
  description    String?
  price          Float
  durationWeeks  Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  teacher      User?        @relation("TeacherCourses", fields: [teacherId], references: [id], onDelete: SetNull)
  enrollments  Enrollment[]
  classes      Class[]
  courseLogs   CourseLog[]
}

// --------------------------------------
// Classes / Cohortes (groupes horaires d'un cours)
// --------------------------------------

/// Classe = cohorte concrète d'un cours avec son créneau horaire
/// (ex : « A1 - Matin », créneau « 08h-11h »).
model Class {
  id             String   @id @default(cuid())
  organizationId String
  courseId       String
  teacherId      String?
  name           String
  /// Créneau horaire synthétique (ex : « 08h-11h ») — conservé pour
  /// compatibilité / affichage rapide. Les créneaux détaillés sont dans
  /// `schedules` (ClassSchedule).
  schedule       String
  /// Frais de scolarité configurés pour la classe (FCFA). Lorsqu'il est
  /// absent, le prix du cours porteur est utilisé comme montant par défaut.
  tuitionFee     Float?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  course       Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teacher      User?             @relation("TeacherClasses", fields: [teacherId], references: [id], onDelete: SetNull)
  enrollments  ClassEnrollment[]
  students     Student[]         @relation("StudentCurrentClass")
  attendances  Attendance[]
  sessions     ClassSession[]
  evaluations  Evaluation[]
  schedules    ClassSchedule[]
}

/// Créneau hebdomadaire d'une classe / cohorte. Plusieurs créneaux peuvent
/// être rattachés à une même classe (ex : Lundi 08h-11h + Mercredi 08h-11h).
/// Permet la gestion de sous-groupes : deux classes distinctes suivant le
/// même cours (ex : Allemand A1) à des heures différentes, avec des
/// professeurs et salles distincts.
model ClassSchedule {
  id        String   @id @default(cuid())
  classId   String
  /// Jour de la semaine : 0 = Dimanche, 1 = Lundi, ..., 6 = Samedi.
  dayOfWeek Int
  /// Heure de début (ex : "07:00").
  startTime String
  /// Heure de fin (ex : "10:00").
  endTime   String
  /// Salle où se déroule le créneau (ex : "Salle 101").
  room      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  class Class @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@index([classId])
  @@index([dayOfWeek])
}

/// Historique des affectations d'un étudiant aux classes / cohortes.
/// Une nouvelle inscription (ex : passage A1 → A2) crée une nouvelle ligne
/// sans supprimer l'historique ; `Student.currentClassId` pointe vers la
/// classe active.
model ClassEnrollment {
  id             String   @id @default(cuid())
  organizationId String
  studentId      String
  classId        String
  enrolledAt     DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class        Class        @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([studentId, classId])
  @@index([classId])
}

model Enrollment {
  id         String   @id @default(cuid())
  studentId  String
  courseId   String
  enrolledAt DateTime @default(now())
  progress   Float    @default(0.0)

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course  Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId])
}

// --------------------------------------
// Pedagogical Models (Présences & Cahier de texte)
// --------------------------------------

/// Séance concrète d'une classe / cohorte (créneau émargé) : matière traitée,
/// chapitre au programme (cahier de texte), date et horaires. Toutes les
/// présences (`Attendance`) sont rattachées strictement à une séance.
model ClassSession {
  id             String   @id @default(cuid())
  organizationId String
  classId        String
  subjectName    String
  /// Chapitre traité pendant la séance (cahier de texte) — requis.
  chapter        String
  /// Résumé du cours / Devoirs donnés pour la séance suivante (cahier de texte).
  summary        String?
  /// Date de la séance (journée, minuit UTC) — les dates passées sont
  /// acceptées pour le suivi historique.
  sessionDate    DateTime
  startTime      DateTime
  endTime        DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  class        Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  attendances  Attendance[]

  @@unique([classId, sessionDate])
  @@index([organizationId])
}

model Attendance {
  id             String           @id @default(cuid())
  organizationId String
  /// Séance émargée (`ClassSession`) — les présences ne sont rattachées
  /// qu'à une séance concrète d'une classe, plus à un cours générique.
  sessionId      String
  /// Classe / cohorte concernée (traceabilité du créneau émargé).
  classId        String?
  studentId      String
  status         AttendanceStatus @default(PRESENT)
  /// Heure d'arrivée effective — renseignée pour le statut `LATE`.
  arrivalTime    DateTime?
  /// Journée de la séance (dénormalisée depuis `ClassSession.sessionDate`,
  /// minuit UTC) pour le tri et les agrégats mensuels.
  date           DateTime         @default(now())
  notes          String?
  createdAt      DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  session      ClassSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  class        Class?       @relation(fields: [classId], references: [id], onDelete: SetNull)
  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([sessionId, studentId])
  @@index([sessionId])
  @@index([sessionId, date])
  @@index([classId])
  @@index([studentId, date])
}

model CourseLog {
  id             String   @id @default(cuid())
  organizationId String
  courseId       String
  teacherId      String
  date           DateTime @default(now())
  chapterTitle   String
  content        String
  homework       String?
  notes          String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  course       Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teacher      User         @relation("TeacherCourseLogs", fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([courseId, date])
}

// --------------------------------------
// Evaluations internes & Notes (Gradebook)
// --------------------------------------

/// Session d'examen interne (ex : « Examen Continu N°1 ») rattachée à une
/// classe / cohorte. Une session regroupe plusieurs modules évalués
/// (compétences ou épreuves) notés indépendamment.
model Evaluation {
  id             String   @id @default(cuid())
  organizationId String
  classId        String
  /// Intitulé de l'examen (ex : « Examen Continu N°1 »).
  title          String
  date           DateTime @default(now())
  createdAt      DateTime @default(now())

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  class        Class              @relation(fields: [classId], references: [id], onDelete: Cascade)
  modules      EvaluationModule[]

  @@index([classId])
  @@index([organizationId])
}

/// Module évalué au sein d'une session d'examen interne
/// (ex : « Lesen », « Hören », « Schreiben », « Sprechen ») avec son barème :
/// note maximale et seuil de validation.
model EvaluationModule {
  id           String   @id @default(cuid())
  evaluationId String
  name         String
  /// Note maximale du module (barème, ex : 100).
  maxScore     Float    @default(100)
  /// Seuil de validation du module (ex : 60).
  passingScore Float    @default(60)
  createdAt    DateTime @default(now())

  evaluation Evaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  grades     Grade[]

  @@index([evaluationId])
}

/// Note obtenue par un étudiant sur un module d'une évaluation interne.
/// L'unicité [moduleId, studentId] permet un upsert idempotent lors de la
/// saisie / re-saisie de la grille de notes.
model Grade {
  id                 String @id @default(cuid())
  evaluationModuleId String
  studentId          String
  score              Float

  evaluationModule EvaluationModule @relation(fields: [evaluationModuleId], references: [id], onDelete: Cascade)
  student          Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([evaluationModuleId, studentId])
  @@index([studentId])
}

// --------------------------------------
// Travel Workflows (Procédures dynamiques)
// --------------------------------------

model Workflow {
  id             String   @id @default(cuid())
  organizationId String
  country        String
  title          String
  description    String?
  isDefault      Boolean  @default(false)
  baseCost       Float    @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stages           WorkflowStage[]
  travelProcedures TravelProcedure[]
}

model WorkflowStage {
  id                String   @id @default(cuid())
  workflowId        String
  organizationId    String
  title             String
  order             Int
  requiredDocuments Json?
  createdAt         DateTime @default(now())

  workflow     Workflow     @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([workflowId, order])
  @@index([organizationId])
}

// --------------------------------------
// Travel Procedures (Accompagnement Voyage)
// --------------------------------------

model TravelProcedure {
  id                   String       @id @default(cuid())
  organizationId       String
  studentId            String?
  candidateName        String?
  candidatePhone       String?
  workflowId           String?
  advisorId            String?
  destination          String
  targetProgram        String?
  status               TravelStatus @default(DOSSIER_PREPARATION)
  totalCost            Float        @default(0)
  discount             Float        @default(0)
  netAmount            Float        @default(0)
  currentStageOrder    Int          @default(0)
  currentStageDeadline DateTime?
  notes                String?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  student      Student?     @relation(fields: [studentId], references: [id], onDelete: SetNull)
  workflow     Workflow?    @relation(fields: [workflowId], references: [id], onDelete: SetNull)
  advisor      User?        @relation("TravelAdvisor", fields: [advisorId], references: [id], onDelete: SetNull)
  payments     Payment[]
  sales        Sale[]
  documents    Document[]
}

// --------------------------------------
// Finance Models
// --------------------------------------

model Payment {
  id                String        @id @default(cuid())
  organizationId    String
  studentId         String?
  travelProcedureId String?
  amount            Float
  currency          String        @default("XOF")
  paymentMethod     PaymentMethod
  status            PaymentStatus @default(COMPLETED)
  /// Écriture suspendue (hors trésorerie active) : valorisé automatiquement
  /// lorsque le statut de l'étudiant repasse à PROSPECT (« Inscrit ➔ Prospect »).
  /// Les enregistrements et reçus sont conservés, mais le montant est exclu de
  /// tous les totaux de trésorerie / cash-flow. Restauré (`isVoided = false`)
  /// lors d'une réinscription (« Prospect ➔ Inscrit »).
  isVoided          Boolean       @default(false)
  reference         String?       @unique
  description       String?
  paidAt            DateTime      @default(now())
  createdAt         DateTime      @default(now())

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  student         Student?         @relation(fields: [studentId], references: [id], onDelete: SetNull)
  travelProcedure TravelProcedure? @relation(fields: [travelProcedureId], references: [id], onDelete: SetNull)
}

model Expense {
  id             String   @id @default(cuid())
  organizationId String
  createdById    String
  title          String
  category       String
  amount         Float
  currency       String   @default("XOF")
  expenseDate    DateTime @default(now())
  receiptUrl     String?
  notes          String?
  createdAt      DateTime @default(now())

  /// Membre bénéficiaire du versement (optionnel) : utilisé notamment pour
  /// les dépenses de catégorie « Salaires » afin de rattacher chaque versement
  /// à un membre de l'équipe (User) et d'en conserver l'historique.
  recipientId String?
  recipient   User?    @relation("ExpenseRecipient", fields: [recipientId], references: [id], onDelete: SetNull)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User         @relation("ExpenseCreator", fields: [createdById], references: [id])
}

model Payroll {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  salaryAmount   Float
  bonus          Float    @default(0)
  deductions     Float    @default(0)
  netPaid        Float
  payPeriod      String // Ex: "2026-08"
  paidAt         DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// --------------------------------------
// Facturation SaaS (abonnements de la plateforme)
// --------------------------------------

/// Facture / transaction d'abonnement EduFlow souscrite par une organisation
/// via la passerelle de paiement (Mobile Money / Carte — Kkiapay ou Fedapay).
///
/// Distincte du modèle `Payment` : celui-ci trace les encaissements des écoles
/// auprès de LEURS clients (étudiants, dossiers de voyage), tandis que
/// `Invoice` trace les achats d'abonnement de la plateforme elle-même
/// (SAAS_MONTHLY / SAAS_YEARLY). Conserver les deux tables séparées évite de
/// polluer les analyses de revenus des centres de formation.
model Invoice {
  id             String    @id @default(cuid())
  organizationId String
  /// Plan souscrit : SAAS_MONTHLY ou SAAS_YEARLY.
  planType       String
  /// Montant payé (XOF / FCFA — pas de centimes).
  amount         Float
  currency       String    @default("XOF")
  /// Agrégateur utilisé : « kkiapay » ou « fedapay ».
  paymentProvider String?
  /// Moyen de paiement signalé par la passerelle (mobile_money, card…).
  paymentMethod  String?
  /// Référence de transaction renvoyée par la passerelle.
  /// Unique : garantit l'idempotence des webhooks (retries inclus).
  transactionReference String? @unique
  /// Statut de la facture : PENDING, COMPLETED ou FAILED.
  status         String    @default("PENDING")
  description    String?
  /// Clé de licence Ed25519 émise lors de l'activation du paiement.
  licenseKey     String?
  /// Début et fin de la période d'abonnement couverte par le paiement.
  periodStart    DateTime?
  periodEnd      DateTime?
  paidAt         DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
}

// --------------------------------------
// Modèle commercial hybride — Grille tarifaire dynamique
// --------------------------------------

/// Formules commerciales de la plateforme (grille tarifaire éditable par le
/// Super-Admin dans /super-admin/pricing) :
/// - SAAS_CLOUD      : abonnement SaaS hébergé (cloud) ;
/// - SELF_HOSTED     : Self-Hosted Docker (installé chez le client) ;
/// - DESKTOP_OFFLINE : Desktop Offline .exe (poste de travail isolé).
enum PricingPlanType {
  SAAS_CLOUD
  SELF_HOSTED
  DESKTOP_OFFLINE
}

/// Grille tarifaire dynamique par formule commerciale (modèle hybride
/// « Acquisition + Renouvellement ») :
/// - initialPrice          : prix de la 1ʳᵉ année (licence + logiciel),
///                           appliqué tant que l'organisation n'a AUCUNE
///                           facture COMPLETED ;
/// - renewalAnnualPrice    : prix de renouvellement pour 12 mois ;
/// - renewalHalfYearPrice  : prix de renouvellement pour 6 mois.
/// Une seule ligne par formule (`planType` unique) — éditée en direct par le
/// Super-Admin via la Server Action `updatePlanPricingAction`.
model PlanPricing {
  id                   String          @id @default(cuid())
  planType             PricingPlanType @unique
  /// Prix 1ʳᵉ année / Licence + Logiciel (XOF / FCFA — pas de centimes).
  initialPrice         Int
  /// Prix de renouvellement 12 mois (XOF / FCFA).
  renewalAnnualPrice   Int
  /// Prix de renouvellement 6 mois (XOF / FCFA).
  renewalHalfYearPrice Int
  currency             String          @default("XOF")
  updatedAt            DateTime        @updatedAt
}

// --------------------------------------
// POS / Ventes annexes
// --------------------------------------
// --------------------------------------
// POS / Ventes annexes
// --------------------------------------

model ProductService {
  id             String           @id @default(cuid())
  organizationId String
  name           String
  /// Catégorie personnalisée (facultative) : un produit peut exister sans
  /// catégorie et apparaît alors sous le filtre « Sans catégorie » du POS.
  categoryId     String?
  unitPrice      Float
  description    String?
  isActive       Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category     ProductCategory?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  saleItems    SaleItem[]

  @@index([organizationId])
  @@index([categoryId])
}

/// Catégorie de produits/services créée par l'organisation (dynamique :
/// l'utilisateur ajoute, renomme ou supprime ses propres catégories — aucune
/// catégorie système figée). La suppression d'une catégorie rend simplement
/// ses produits « sans catégorie » (`onDelete: SetNull`).
model ProductCategory {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  products     ProductService[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model Sale {
  id                String         @id @default(cuid())
  organizationId    String
  studentId         String?
  travelProcedureId String?
  createdById       String
  totalAmount       Float
  discount          Float          @default(0)
  netAmount         Float
  paymentMethod     PaymentMethod?
  status            SaleStatus     @default(COMPLETED)
  /// Coordonnées optionnelles d'un client de passage (vente anonyme) :
  /// imprimées sur la facturette sous « Client de passage : Nom - Téléphone ».
  guestName         String?
  guestPhone        String?
  createdAt         DateTime       @default(now())

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  student         Student?         @relation(fields: [studentId], references: [id], onDelete: SetNull)
  travelProcedure TravelProcedure? @relation(fields: [travelProcedureId], references: [id], onDelete: SetNull)
  cashier         User             @relation("SaleCreator", fields: [createdById], references: [id])
  items           SaleItem[]
}

model SaleItem {
  id               String @id @default(cuid())
  saleId           String
  productServiceId String
  quantity         Int    @default(1)
  unitPrice        Float
  subtotal         Float

  sale           Sale           @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productService ProductService @relation(fields: [productServiceId], references: [id], onDelete: Restrict)
}

// --------------------------------------
// Operations & Collaboration Models
// --------------------------------------

model Task {
  id             String       @id @default(cuid())
  organizationId String
  createdById    String
  assigneeId     String?
  studentId      String?
  title          String
  description    String?
  status         TaskStatus   @default(TODO)
  priority       TaskPriority @default(MEDIUM)
  dueDate        DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User         @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Restrict)
  assignee     User?        @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  student      Student?     @relation(fields: [studentId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([assigneeId])
  @@index([dueDate])
}

// --------------------------------------
// Rôles personnalisés (matrice de permissions)
// --------------------------------------

/// Rôle créé par l'administrateur avec une matrice de permissions simples
/// (Accès Finance, Inscription, Suppression, POS, Voyages, Évaluations…).
/// Les permissions sont stockées en `String[]` (tableau SQL PostgreSQL natif)
/// pour une interrogation directe en base et un affichage immédiat de la liste.
model CustomRole {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String?
  permissions    String[] @default([])
  /// Rôle créé par le système (ex : « Secrétaire Adjoint » pré-configuré) :
  /// sa suppression est restreinte.
  isSystem       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users        User[]

  @@index([organizationId])
}

// --------------------------------------
// Logements (hébergement des étudiants en mobilité)
// --------------------------------------

/// Fiche de logement rattachée à un étudiant (souvent en mobilité) :
/// adresse, ville, loyer mensuel, dépôt de garantie et période du contrat.
/// Utilisée par le seeding de démonstration et consultable dans la fiche
/// voyage de l'étudiant.
model Housing {
  id             String    @id @default(cuid())
  organizationId String
  studentId      String
  name           String
  address        String?
  city           String?
  monthlyRent    Float
  deposit        Float     @default(0)
  contractStart  DateTime?
  contractEnd    DateTime?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([studentId])
}

// --------------------------------------
// Programme de Parrainage (Referral)
// --------------------------------------

model Referral {
  id           String         @id @default(cuid())
  referrerId   String
  referredId   String         @unique
  status       ReferralStatus @default(PENDING)
  rewardAmount Float          @default(0)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  referrer User @relation("ReferrerUser", fields: [referrerId], references: [id], onDelete: Cascade)
  referred User @relation("ReferredUser", fields: [referredId], references: [id], onDelete: Cascade)

  @@index([referrerId])
  @@index([status])
}
