generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --------------------------------------
// Enums
// --------------------------------------

enum Role {
  SUPER_ADMIN
  ADMIN
  STAFF
  TEACHER
  STUDENT
}

enum StudentStatus {
  PROSPECT
  ENROLLED
  IN_PROGRESS
  COMPLETED
  SUSPENDED
  DROPPED_OUT
}

enum PaymentStatus {
  PENDING
  PARTIAL
  COMPLETED
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  MOBILE_MONEY
  CREDIT_CARD
  CHECK
}

enum TravelStatus {
  DOSSIER_PREPARATION
  LANGUAGE_TEST
  ADMISSION_APPLIED
  ADMISSION_OBTAINED
  VISA_APPLIED
  VISA_APPROVED
  VISA_REJECTED
  DEPARTURE_READY
  COMPLETED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// --------------------------------------
// Core / Multi-Tenant Models
// --------------------------------------

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  email     String?
  phone     String?
  address   String?
  logoUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users            User[]
  students         Student[]
  courses          Course[]
  payments         Payment[]
  travelProcedures TravelProcedure[]
  expenses         Expense[]
  payrolls         Payroll[]
  tasks            Task[]
}

model User {
  id             String   @id @default(cuid())
  organizationId String
  email          String   @unique
  passwordHash   String
  firstName      String
  lastName       String
  role           Role     @default(STAFF)
  avatarUrl      String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  taughtCourses    Course[]          @relation("TeacherCourses")
  createdExpenses  Expense[]         @relation("ExpenseCreator")
  payrolls         Payroll[]
  assignedTasks    Task[]            @relation("TaskAssignee")
  createdTasks     Task[]            @relation("TaskCreator")
  managedTravels   TravelProcedure[] @relation("TravelAdvisor")
}

// --------------------------------------
// Student & Academic Models
// --------------------------------------

model Student {
  id             String        @id @default(cuid())
  organizationId String
  studentCode    String        @unique
  firstName      String
  lastName       String
  email          String?
  phone          String
  dateOfBirth    DateTime?
  address        String?
  status         StudentStatus @default(PROSPECT)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  enrollments      Enrollment[]
  payments         Payment[]
  travelProcedures TravelProcedure[]
}

model Course {
  id             String   @id @default(cuid())
  organizationId String
  teacherId      String?
  title          String
  code           String
  description    String?
  price          Float
  durationWeeks  Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  teacher      User?        @relation("TeacherCourses", fields: [teacherId], references: [id], onDelete: SetNull)
  enrollments  Enrollment[]
}

model Enrollment {
  id         String   @id @default(cuid())
  studentId  String
  courseId   String
  enrolledAt DateTime @default(now())
  progress   Float    @default(0.0)

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course  Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId])
}

// --------------------------------------
// Travel Procedures (Accompagnement Voyage)
// --------------------------------------

model TravelProcedure {
  id             String       @id @default(cuid())
  organizationId String
  studentId      String
  advisorId      String?
  destination    String
  targetProgram  String?
  status         TravelStatus @default(DOSSIER_PREPARATION)
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  advisor      User?        @relation("TravelAdvisor", fields: [advisorId], references: [id], onDelete: SetNull)
}

// --------------------------------------
// Finance Models
// --------------------------------------

model Payment {
  id             String        @id @default(cuid())
  organizationId String
  studentId      String
  amount         Float
  currency       String        @default("XOF")
  paymentMethod  PaymentMethod
  status         PaymentStatus @default(COMPLETED)
  reference      String?       @unique
  description    String?
  paidAt         DateTime      @default(now())
  createdAt      DateTime      @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model Expense {
  id             String   @id @default(cuid())
  organizationId String
  createdById    String
  title          String
  category       String
  amount         Float
  currency       String   @default("XOF")
  expenseDate    DateTime @default(now())
  receiptUrl     String?
  notes          String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User         @relation("ExpenseCreator", fields: [createdById], references: [id])
}

model Payroll {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  salaryAmount   Float
  bonus          Float    @default(0)
  deductions     Float    @default(0)
  netPaid        Float
  payPeriod      String   // Ex: "2026-08"
  paidAt         DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// --------------------------------------
// Operations & Collaboration Models
// --------------------------------------

model Task {
  id             String       @id @default(cuid())
  organizationId String
  createdById    String
  assigneeId     String?
  title          String
  description    String?
  status         TaskStatus   @default(TODO)
  priority       TaskPriority @default(MEDIUM)
  dueDate        DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User         @relation("TaskCreator", fields: [createdById], references: [id])
  assignee     User?        @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
}