generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// --------------------------------------
// Enums
// --------------------------------------

enum Role {
  SUPER_ADMIN
  ADMIN
  STAFF
  TEACHER
  STUDENT
}

enum StudentStatus {
  PROSPECT
  ENROLLED
  IN_PROGRESS
  COMPLETED
  SUSPENDED
  DROPPED_OUT
}

enum ClientType {
  LANGUAGE_ONLY
  LANGUAGE_AND_TRAVEL
  TRAVEL_ONLY
}

enum PaymentStatus {
  PENDING
  PARTIAL
  COMPLETED
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  MOBILE_MONEY
  CREDIT_CARD
  CHECK
}

enum TravelStatus {
  DOSSIER_PREPARATION
  LANGUAGE_TEST
  ADMISSION_APPLIED
  ADMISSION_OBTAINED
  VISA_APPLIED
  VISA_APPROVED
  VISA_REJECTED
  DEPARTURE_READY
  COMPLETED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum ProductCategory {
  BOOK
  TRANSLATION
  COPY_SERVICE
}

enum SaleStatus {
  COMPLETED
  PENDING
  REFUNDED
}

enum DocumentType {
  PASSPORT
  IDENTITY
  DIPLOMA
  OTHER
}

// --------------------------------------
// Documents & Pièces jointes
// --------------------------------------

/// Pièce jointe rattachée à un étudiant ou à un dossier de voyage.
/// Le fichier lui-même est conservé sur un stockage externe (Drive, storage) ;
/// seul le lien distant (`fileUrl`) est enregistré en base.
model Document {
  id               String       @id @default(cuid())
  organizationId   String
  title            String
  type             DocumentType @default(OTHER)
  fileUrl          String
  fileSize         Int?
  studentId        String?
  travelProcedureId String?
  createdAt        DateTime     @default(now())

  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  student          Student?          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  travelProcedure  TravelProcedure? @relation(fields: [travelProcedureId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([studentId])
  @@index([travelProcedureId])
}

// --------------------------------------
// Core / Multi-Tenant Models
// --------------------------------------

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  email     String?
  phone     String?
  address   String?
  city      String?
  website   String?
  logoUrl   String?
  rccm      String?
  ifu       String?
  /// Frais d'inscription uniques facturés une seule fois par étudiant (FCFA).
  defaultRegistrationFee Float    @default(15000)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users            User[]
  students         Student[]
  courses          Course[]
  classes          Class[]
  classEnrollments ClassEnrollment[]
  payments         Payment[]
  travelProcedures TravelProcedure[]
  expenses         Expense[]
  payrolls         Payroll[]
  tasks            Task[]
  workflows        Workflow[]
  workflowStages    WorkflowStage[]
  productServices  ProductService[]
  sales            Sale[]
  attendances      Attendance[]
  courseLogs        CourseLog[]
  evaluations      Evaluation[]
  documents        Document[]
}

model User {
  id             String   @id @default(cuid())
  organizationId String
  email          String   @unique
  passwordHash   String
  firstName      String
  lastName       String
  role           Role     @default(STAFF)
  avatarUrl      String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  taughtCourses    Course[]          @relation("TeacherCourses")
  taughtClasses    Class[]           @relation("TeacherClasses")
  createdExpenses  Expense[]         @relation("ExpenseCreator")
  payrolls         Payroll[]
  assignedTasks    Task[]            @relation("TaskAssignee")
  createdTasks     Task[]            @relation("TaskCreator")
  managedTravels   TravelProcedure[] @relation("TravelAdvisor")
  createdSales     Sale[]            @relation("SaleCreator")
  courseLogs       CourseLog[]       @relation("TeacherCourseLogs")
}

// --------------------------------------
// Student & Academic Models
// --------------------------------------

model Student {
  id             String        @id @default(cuid())
  organizationId String
  studentCode    String        @unique
  firstName      String
  lastName       String
  email          String?
  phone          String
  clientType     ClientType    @default(LANGUAGE_AND_TRAVEL)
  totalCost      Float?
  discount       Float?
  netAmount      Float?
  dateOfBirth    DateTime?
  address        String?
  status         StudentStatus @default(PROSPECT)
  /// Frais d'inscription déjà réglés au moins une fois (uniques à vie).
  hasPaidRegistrationFee Boolean @default(false)
  /// Classe / cohorte active de l'étudiant (dernière affectation).
  currentClassId String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  enrollments      Enrollment[]
  classEnrollments ClassEnrollment[]
  currentClass     Class?            @relation("StudentCurrentClass", fields: [currentClassId], references: [id], onDelete: SetNull)
  payments         Payment[]
  travelProcedures TravelProcedure[]
  tasks            Task[]
  attendances      Attendance[]
  sales            Sale[]
  grades           Grade[]
  documents        Document[]
}

model Course {
  id             String   @id @default(cuid())
  organizationId String
  teacherId      String?
  title          String
  code           String
  description    String?
  price          Float
  durationWeeks  Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  teacher      User?        @relation("TeacherCourses", fields: [teacherId], references: [id], onDelete: SetNull)
  enrollments  Enrollment[]
  classes      Class[]
  courseLogs   CourseLog[]
  attendances  Attendance[]
}

// --------------------------------------
// Classes / Cohortes (groupes horaires d'un cours)
// --------------------------------------

/// Classe = cohorte concrète d'un cours avec son créneau horaire
/// (ex : « A1 - Matin », créneau « 08h-11h »).
model Class {
  id             String   @id @default(cuid())
  organizationId String
  courseId       String
  teacherId      String?
  name           String
  schedule       String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  course       Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teacher      User?             @relation("TeacherClasses", fields: [teacherId], references: [id], onDelete: SetNull)
  enrollments  ClassEnrollment[]
  students     Student[]         @relation("StudentCurrentClass")
  attendances  Attendance[]
  evaluations  Evaluation[]
}

/// Historique des affectations d'un étudiant aux classes / cohortes.
/// Une nouvelle inscription (ex : passage A1 → A2) crée une nouvelle ligne
/// sans supprimer l'historique ; `Student.currentClassId` pointe vers la
/// classe active.
model ClassEnrollment {
  id             String   @id @default(cuid())
  organizationId String
  studentId      String
  classId        String
  enrolledAt     DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class        Class        @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([studentId, classId])
  @@index([classId])
}

model Enrollment {
  id         String   @id @default(cuid())
  studentId  String
  courseId   String
  enrolledAt DateTime @default(now())
  progress   Float    @default(0.0)

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course  Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId])
}

// --------------------------------------
// Pedagogical Models (Présences & Cahier de texte)
// --------------------------------------

model Attendance {
  id             String           @id @default(cuid())
  organizationId String
  courseId       String
  /// Classe / cohorte concernée (traceabilité du créneau émargé).
  classId        String?
  studentId      String
  status         AttendanceStatus @default(PRESENT)
  date           DateTime         @default(now())
  notes          String?
  createdAt      DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  course       Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  class        Class?       @relation(fields: [classId], references: [id], onDelete: SetNull)
  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([courseId, studentId, date])
  @@index([courseId, date])
  @@index([classId])
}

model CourseLog {
  id             String   @id @default(cuid())
  organizationId String
  courseId       String
  teacherId      String
  date           DateTime @default(now())
  chapterTitle   String
  content        String
  homework       String?
  notes          String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  course       Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teacher      User         @relation("TeacherCourseLogs", fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([courseId, date])
}

// --------------------------------------
// Evaluations internes & Notes (Gradebook)
// --------------------------------------

/// Session d'examen interne (ex : « Examen Continu N°1 ») rattachée à une
/// classe / cohorte. Une session regroupe plusieurs modules évalués
/// (compétences ou épreuves) notés indépendamment.
model Evaluation {
  id             String   @id @default(cuid())
  organizationId String
  classId        String
  /// Intitulé de l'examen (ex : « Examen Continu N°1 »).
  title          String
  date           DateTime @default(now())
  createdAt      DateTime @default(now())

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  class        Class              @relation(fields: [classId], references: [id], onDelete: Cascade)
  modules      EvaluationModule[]

  @@index([classId])
  @@index([organizationId])
}

/// Module évalué au sein d'une session d'examen interne
/// (ex : « Lesen », « Hören », « Schreiben », « Sprechen ») avec son barème :
/// note maximale et seuil de validation.
model EvaluationModule {
  id           String   @id @default(cuid())
  evaluationId String
  name         String
  /// Note maximale du module (barème, ex : 100).
  maxScore     Float    @default(100)
  /// Seuil de validation du module (ex : 60).
  passingScore Float    @default(60)
  createdAt    DateTime @default(now())

  evaluation Evaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  grades     Grade[]

  @@index([evaluationId])
}

/// Note obtenue par un étudiant sur un module d'une évaluation interne.
/// L'unicité [moduleId, studentId] permet un upsert idempotent lors de la
/// saisie / re-saisie de la grille de notes.
model Grade {
  id                 String @id @default(cuid())
  evaluationModuleId String
  studentId          String
  score              Float

  evaluationModule EvaluationModule @relation(fields: [evaluationModuleId], references: [id], onDelete: Cascade)
  student          Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([evaluationModuleId, studentId])
  @@index([studentId])
}

// --------------------------------------
// Travel Workflows (Procédures dynamiques)
// --------------------------------------

model Workflow {
  id             String   @id @default(cuid())
  organizationId String
  country        String
  title          String
  description    String?
  isDefault      Boolean  @default(false)
  baseCost       Float    @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stages          WorkflowStage[]
  travelProcedures TravelProcedure[]
}

model WorkflowStage {
  id               String   @id @default(cuid())
  workflowId       String
  organizationId   String
  title            String
  order            Int
  requiredDocuments Json?
  createdAt        DateTime @default(now())

  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([workflowId, order])
  @@index([organizationId])
}

// --------------------------------------
// Travel Procedures (Accompagnement Voyage)
// --------------------------------------

model TravelProcedure {
  id                  String       @id @default(cuid())
  organizationId      String
  studentId           String?
  candidateName       String?
  candidatePhone      String?
  workflowId          String?
  advisorId           String?
  destination         String
  targetProgram       String?
  status              TravelStatus @default(DOSSIER_PREPARATION)
  totalCost           Float        @default(0)
  discount            Float        @default(0)
  netAmount           Float        @default(0)
  currentStageOrder   Int          @default(0)
  currentStageDeadline DateTime?
  notes               String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  student     Student?           @relation(fields: [studentId], references: [id], onDelete: SetNull)
  workflow    Workflow?          @relation(fields: [workflowId], references: [id], onDelete: SetNull)
  advisor     User?              @relation("TravelAdvisor", fields: [advisorId], references: [id], onDelete: SetNull)
  payments    Payment[]
  sales       Sale[]
  documents   Document[]
}

// --------------------------------------
// Finance Models
// --------------------------------------

model Payment {
  id                String        @id @default(cuid())
  organizationId    String
  studentId         String?
  travelProcedureId String?
  amount            Float
  currency          String        @default("XOF")
  paymentMethod     PaymentMethod
  status            PaymentStatus @default(COMPLETED)
  reference         String?       @unique
  description       String?
  paidAt            DateTime      @default(now())
  createdAt         DateTime      @default(now())

  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  student         Student?          @relation(fields: [studentId], references: [id], onDelete: SetNull)
  travelProcedure TravelProcedure? @relation(fields: [travelProcedureId], references: [id], onDelete: SetNull)
}

model Expense {
  id             String   @id @default(cuid())
  organizationId String
  createdById    String
  title          String
  category       String
  amount         Float
  currency       String   @default("XOF")
  expenseDate    DateTime @default(now())
  receiptUrl     String?
  notes          String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User         @relation("ExpenseCreator", fields: [createdById], references: [id])
}

model Payroll {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  salaryAmount   Float
  bonus          Float    @default(0)
  deductions     Float    @default(0)
  netPaid        Float
  payPeriod      String   // Ex: "2026-08"
  paidAt         DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// --------------------------------------
// POS / Ventes annexes
// --------------------------------------

model ProductService {
  id             String          @id @default(cuid())
  organizationId String
  name           String
  category       ProductCategory @default(BOOK)
  unitPrice      Float
  description    String?
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  saleItems     SaleItem[]
}

model Sale {
  id                String          @id @default(cuid())
  organizationId    String
  studentId         String?
  travelProcedureId String?
  createdById       String
  totalAmount       Float
  discount          Float           @default(0)
  netAmount         Float
  paymentMethod     PaymentMethod?
  status            SaleStatus      @default(COMPLETED)
  createdAt         DateTime        @default(now())

  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  student         Student?          @relation(fields: [studentId], references: [id], onDelete: SetNull)
  travelProcedure TravelProcedure?  @relation(fields: [travelProcedureId], references: [id], onDelete: SetNull)
  cashier         User              @relation("SaleCreator", fields: [createdById], references: [id])
  items           SaleItem[]
}

model SaleItem {
  id               String          @id @default(cuid())
  saleId           String
  productServiceId String
  quantity         Int             @default(1)
  unitPrice        Float
  subtotal         Float

  sale           Sale            @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productService ProductService  @relation(fields: [productServiceId], references: [id], onDelete: Restrict)
}

// --------------------------------------
// Operations & Collaboration Models
// --------------------------------------

model Task {
  id             String       @id @default(cuid())
  organizationId String
  createdById    String
  assigneeId     String?
  studentId      String?
  title          String
  description    String?
  status         TaskStatus   @default(TODO)
  priority       TaskPriority @default(MEDIUM)
  dueDate        DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User         @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Restrict)
  assignee     User?        @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  student      Student?     @relation(fields: [studentId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([assigneeId])
  @@index([dueDate])
}